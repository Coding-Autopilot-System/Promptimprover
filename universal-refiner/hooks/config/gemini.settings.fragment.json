{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "promptimprover-pre-prompt",
            "type": "command",
            "command": "promptimprover-hook-pre",
            "timeout": 20
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "promptimprover-post-execution",
            "type": "command",
            "command": "promptimprover-hook-post",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
